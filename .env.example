REACT_APP_API_URL=

# Map: MapLibre + raster XYZ tiles (no Mapbox token). Comma-separated URL templates using {z}, {x}, {y}.
# Default falls back to demo OSM tile server — for production use your own tile host and respect tile policies.
REACT_APP_MAP_RASTER_TILES=
# Optional HTML attribution string (shown on map). Defaults to OSM attribution if empty.
REACT_APP_MAP_RASTER_ATTRIBUTION=
